<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dear <%= data.owner_name %> - 专属纪念页</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
            background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
            color: #2e4a3a;
            min-height: 100vh;
        }
        .page { max-width: 800px; margin: 0 auto; padding: 40px 20px; }
        .hero {
            text-align: center;
            padding: 80px 0 60px;
        }
        .hero h1 {
            font-size: 3em;
            color: #43a047;
            margin-bottom: 10px;
        }
        .hero .intro { font-size: 1.2em; color: #388e3c; }
        .stories { margin: 40px 0; }
        .story {
            background: white;
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 20px;
            box-shadow: 0 2px 15px rgba(76,175,80,0.15);
        }
        .story h3 { color: #43a047; margin-bottom: 15px; }
        .story p { line-height: 1.8; }
        .message-section {
            background: linear-gradient(135deg, #43a047, #66bb6a);
            color: white;
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            margin: 40px 0;
        }
        /* 留言区左对齐 */
		.message-section p {
			font-size: 1.15em;
			line-height: 2;
			text-align: left;        /* 左对齐 */
			white-space: pre-wrap;   /* 保留换行 */
			word-break: break-word;  /* 长单词换行 */
		}

		/* 签名区 */
		.signature-area {
			text-align: right;
			margin-top: 60px;
			padding: 30px 0;
			border-top: 1px solid #f0e0e5;
		}
		.signature-area .signature-name {
			font-size: 1.3em;
			font-weight: bold;
		}
		.signature-area .signature-date {
			font-size: 0.9em;
			opacity: 0.7;
			margin-top: 5px;
		}

		/* 底部版权 */
		.footer-line {
			text-align: center;
			padding: 40px 0 20px;
			font-size: 0.9em;
			opacity: 0.6;
		}
    </style>
</head>
<body>
    <div class="page">
        <section class="hero">
            <h1><%= data.owner_name %></h1>
            <% if (data.dedication) { %>
				<p class="intro"><%= data.dedication %></p>
			<% } %>
        </section>
        
        <% if (data.stories && data.stories.length > 0) { %>
        <section class="stories">
            <% data.stories.forEach(function(story) { %>
                <div class="story">
                    <h3>🌟 <%= story.title %></h3>
                    <p><%= story.content %></p>
                </div>
            <% }); %>
        </section>
        <% } %>
        
        <% if (data.message) { %>
        <section class="message-section">
            <h2>💬 想对你说</h2>
            <p><%= data.message %></p>
        </section>
        <% } %>
        
		<!-- 签名区 -->
		<section class="signature-area">
			<% if (data.basic_info && data.basic_info.authorName) { %>
				<p class="signature-name"><%= data.basic_info.authorName %></p>
			<% } else { %>
				<p class="signature-name">爱你的人</p>
			<% } %>
			<p class="signature-date"><%= new Date().toLocaleDateString('zh-CN', {year:'numeric', month:'long', day:'numeric'}) %></p>
		</section>

        <footer class="footer">
            <p class="footer-line">Made with <span class="heart">❤️</span> by Dear</p>
        </footer>
    </div>
</body>
</html>