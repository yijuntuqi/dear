<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dear <%= data.owner_name %> - 专属纪念页</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
            background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
            color: #5d4037;
            min-height: 100vh;
        }
        .page { max-width: 800px; margin: 0 auto; padding: 40px 20px; }
        .hero {
            text-align: center;
            padding: 80px 0 60px;
        }
        .hero h1 {
            font-size: 3em;
            color: #e65100;
            margin-bottom: 10px;
        }
        .hero .dedication {
            font-size: 1.3em;
            color: #bf360c;
            margin-top: 15px;
            font-style: italic;
        }
        .stories { margin: 40px 0; }
        .story {
            background: white;
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 20px;
            border-left: 4px solid #ff9800;
            box-shadow: 0 2px 15px rgba(255,152,0,0.15);
        }
        .story h3 { color: #e65100; margin-bottom: 15px; }
        .story p { line-height: 1.8; }
        .message-section {
            background: linear-gradient(135deg, #ff9800, #f57c00);
            color: white;
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            margin: 40px 0;
        }
        .footer { text-align: center; padding: 40px 0; color: #bf360c; }
    </style>
</head>
<body>
    <div class="page">
        <section class="hero">
            <h1><%= data.owner_name %></h1>
            <% if (data.dedication) { %>
                <p class="dedication"><%= data.dedication %></p>
            <% } %>
        </section>
        
        <% if (data.stories && data.stories.length > 0) { %>
        <section class="stories">
            <% data.stories.forEach(function(story) { %>
                <div class="story">
                    <h3>🧡 <%= story.title %></h3>
                    <p><%= story.content %></p>
                </div>
            <% }); %>
        </section>
        <% } %>
        
        <% if (data.message) { %>
        <section class="message-section">
            <h2>💌 想对你说</h2>
            <p><%= data.message %></p>
        </section>
        <% } %>
        
        <footer class="footer">
            <p>Made with 🧡 by Dear</p>
        </footer>
    </div>
</body>
</html>