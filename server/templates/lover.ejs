<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dear <%= data.owner_name %> - 专属纪念页</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
            background: linear-gradient(135deg, #fce4ec 0%, #f8bbd0 100%);
            color: #5d3a4a;
            min-height: 100vh;
        }
        .page {
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        .hero {
            text-align: center;
            padding: 80px 0 60px;
            position: relative;
        }
        .hero::before {
            content: '💕';
            font-size: 4em;
            display: block;
            margin-bottom: 20px;
            animation: float 3s ease-in-out infinite;
        }
        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .hero h1 {
            font-size: 3em;
            background: linear-gradient(135deg, #e91e63, #f06292);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }
        .hero .intro {
            font-size: 1.2em;
            color: #ad1457;
        }
        .stories { margin: 40px 0; }
        .story {
            background: rgba(255,255,255,0.8);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 20px;
            border-left: 4px solid #e91e63;
        }
        .story h3 { color: #e91e63; margin-bottom: 15px; }
        .story p { line-height: 1.8; }
        .message-section {
            background: linear-gradient(135deg, #e91e63, #f06292);
            color: white;
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            margin: 40px 0;
        }
        .footer { text-align: center; padding: 40px 0; color: #ad1457; }
    </style>
</head>
<body>
    <div class="page">
        <section class="hero">
            <h1><%= data.owner_name %></h1>
            <p class="intro">我最爱的人</p>
        </section>
        
        <% if (data.stories && data.stories.length > 0) { %>
        <section class="stories">
            <% data.stories.forEach(function(story) { %>
                <div class="story">
                    <h3>💕 <%= story.title %></h3>
                    <p><%= story.content %></p>
                </div>
            <% }); %>
        </section>
        <% } %>
        
        <% if (data.message) { %>
        <section class="message-section">
            <h2>💌 想对你说</h2>
            <p><%= data.message %></p>
        </section>
        <% } %>
        
        <footer class="footer">
            <p>Made with 💕 by Dear</p>
        </footer>
    </div>
</body>
</html>