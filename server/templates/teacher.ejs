<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dear <%= data.owner_name %> - 专属纪念页</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
            background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
            color: #5d4037;
            min-height: 100vh;
        }
        .page { max-width: 800px; margin: 0 auto; padding: 40px 20px; }
        .hero {
            text-align: center;
            padding: 80px 0 60px;
        }
        .hero h1 {
            font-size: 3em;
            color: #f57c00;
            margin-bottom: 10px;
        }
        .hero .intro { font-size: 1.2em; color: #e65100; }
        .stories { margin: 40px 0; }
        .story {
            background: white;
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 20px;
            border-top: 4px solid #f57c00;
            box-shadow: 0 2px 15px rgba(245,124,0,0.1);
        }
        .story h3 { color: #f57c00; margin-bottom: 15px; }
        .story p { line-height: 1.8; }
        .message-section {
            background: linear-gradient(135deg, #f57c00, #ff9800);
            color: white;
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            margin: 40px 0;
        }
        .footer { text-align: center; padding: 40px 0; color: #e65100; }
    </style>
</head>
<body>
    <div class="page">
        <section class="hero">
            <h1><%= data.owner_name %></h1>
            <p class="intro">敬爱的老师 📚</p>
        </section>
        
        <% if (data.stories && data.stories.length > 0) { %>
        <section class="stories">
            <% data.stories.forEach(function(story) { %>
                <div class="story">
                    <h3>📚 <%= story.title %></h3>
                    <p><%= story.content %></p>
                </div>
            <% }); %>
        </section>
        <% } %>
        
        <% if (data.message) { %>
        <section class="message-section">
            <h2>🙏 想对您说</h2>
            <p><%= data.message %></p>
        </section>
        <% } %>
        
        <footer class="footer">
            <p>Made with 📚 by Dear</p>
        </footer>
    </div>
</body>
</html>