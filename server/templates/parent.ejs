<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dear <%= data.owner_name %> - 专属纪念页</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
            background: linear-gradient(135deg, #fff5f7 0%, #ffe0e6 100%);
            color: #4a4a4a;
            min-height: 100vh;
        }
        .page {
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        .hero {
            text-align: center;
            padding: 80px 0 60px;
        }
        .hero h1 {
            font-size: 3em;
            color: #ff6b8a;
            margin-bottom: 10px;
        }
        .hero .relation {
            font-size: 1.2em;
            color: #999;
            margin-bottom: 20px;
        }
        .hero .intro {
            font-size: 1.3em;
            color: #666;
            font-style: italic;
        }
        .stories {
            margin: 40px 0;
        }
        .story {
            background: white;
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 20px;
            box-shadow: 0 2px 20px rgba(255,107,138,0.1);
        }
        .story h3 {
            color: #ff6b8a;
            margin-bottom: 15px;
            font-size: 1.3em;
        }
        .story p {
            line-height: 1.8;
            font-size: 1.05em;
        }
        .message-section {
            background: linear-gradient(135deg, #ff6b8a, #ffa3b5);
            color: white;
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            margin: 40px 0;
        }
        .message-section h2 {
            margin-bottom: 20px;
        }
        .message-section p {
            font-size: 1.2em;
            line-height: 2;
        }
        .footer {
            text-align: center;
            padding: 40px 0;
            color: #999;
        }
        .footer .heart {
            color: #ff6b8a;
            font-size: 1.5em;
        }
    </style>
</head>
<body>
    <div class="page">
        <section class="hero">
            <h1><%= data.owner_name %></h1>
            <p class="relation">
                <% const relationMap = {parent: '亲爱的爸爸/妈妈', lover: '最爱的伴侣', friend: '最好的朋友', teacher: '敬爱的老师'}; %>
                <%= relationMap[data.relationship] || '重要的人' %>
            </p>
            <% if (data.basic_info && data.basic_info.intro) { %>
                <p class="intro"><%= data.basic_info.intro %></p>
            <% } %>
        </section>
        
        <% if (data.stories && data.stories.length > 0) { %>
        <section class="stories">
            <% data.stories.forEach(function(story) { %>
                <div class="story">
                    <h3><%= story.title %></h3>
                    <p><%= story.content %></p>
                </div>
            <% }); %>
        </section>
        <% } %>
        
        <% if (data.message) { %>
        <section class="message-section">
            <h2>💌 想对你说</h2>
            <p><%= data.message %></p>
        </section>
        <% } %>
        
        <footer class="footer">
            <p>Made with <span class="heart">❤️</span> by Dear</p>
            <p>Created on <%= new Date().toLocaleDateString('zh-CN') %></p>
        </footer>
    </div>
</body>
</html>